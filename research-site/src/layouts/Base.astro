
---
import '../styles/global.css';
import { nav, person } from '../data/site.mjs';
const { title='Home', description=person.description, pathname=Astro.url.pathname } = Astro.props;
const site='https://lifeismoment.github.io';
const canonical=new URL(pathname,site).href;
const navPath=pathname==='/index.html'?'/':pathname;
const structured={
 '@context':'https://schema.org','@type':'Person',
 'name':'윤재성','alternateName':'Jaeseong Yun',
 'url':site,'sameAs':[person.github],
 'knowsAbout':['Artificial intelligence','Industrial anomaly detection','On-premises AI','Software testing']
};
---
<!doctype html>
<html lang="ko" data-site="astro-academic">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>{title} | 윤재성 · AI Research</title>
 <meta name="description" content={description} />
 <meta name="theme-color" content="#fdfdfc" />
 <meta property="og:type" content="website" />
 <meta property="og:title" content={title+' | 윤재성'} />
 <meta property="og:description" content={description} />
 <meta property="og:url" content={canonical} />
 <meta property="og:image" content={site+person.portrait} />
 <link rel="canonical" href={canonical} />
 <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
 <script type="application/ld+json" set:html={JSON.stringify(structured)} />
</head>
<body>
 <a class="skip" href="#main">본문으로 이동</a>
 <header class="site-header">
   <div class="container header-inner">
     <a href="/" class="brand">Jaeseong Yun <span>Research</span></a>
     <nav class="desktop-nav" aria-label="주 메뉴">
       {nav.map(item=><a href={item.url} aria-current={item.url===navPath?'page':undefined}>{item.name}</a>)}
     </nav>
     <details class="mobile-nav">
       <summary aria-label="메뉴 열기">메뉴 ☰</summary>
       <nav class="mobile-links" aria-label="모바일 메뉴">
         {nav.map(item=><a href={item.url}>{item.name}</a>)}
       </nav>
     </details>
   </div>
 </header>
 <main id="main">
   <slot />
 </main>
 <footer class="site-footer">
   <div class="container footer-inner">
     <div>© 2026 Jaeseong Yun. 연구 상태·공동 기여·지식재산 명의를 구분하여 공개합니다.</div>
     <div class="footer-links"><a href="/publications.html">논문·저서</a><a href="/notes.html">연구 노트</a><a href={person.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
   </div>
 </footer>
 <script>
   document.querySelectorAll('[data-filter-root]').forEach(root=>{
     let kind='all';
     const search=root.querySelector('[data-search]');
     const cards=[...root.querySelectorAll('[data-kind]')];
     const refresh=()=>{
       const term=(search?.value||'').trim().toLowerCase();
       let count=0;
       for(const card of cards){
         const visible=(kind==='all'||card.dataset.kind===kind)&&card.textContent.toLowerCase().includes(term);
         card.hidden=!visible;
         if(visible)count++;
       }
       const total=root.querySelector('[data-total]');
       if(total)total.textContent=count+'개 항목';
     };
     root.querySelectorAll('[data-kind-filter]').forEach(button=>{
       button.addEventListener('click',()=>{
         kind=button.dataset.kindFilter;
         root.querySelectorAll('[data-kind-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
         refresh();
       });
     });
     search?.addEventListener('input',refresh);
     refresh();
   });
 </script>
</body>
</html>
