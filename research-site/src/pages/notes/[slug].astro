
---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
 const entries=await getCollection('notes');
 return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const date=entry.data.date.toISOString().slice(0,10);
---
<Base title={entry.data.title} description={entry.data.description} pathname={'/notes/'+entry.id+'.html'}>
 <article class="article">
   <p class="eyebrow">Research note / {entry.data.category}</p>
   <h1>{entry.data.title}</h1>
   <p class="article-subtitle">{entry.data.description}</p>
   <div class="article-meta"><time datetime={date}>{date}</time><span>{entry.data.status}</span></div>
   <div class="prose"><Content /></div>
   <div class="notice" style="margin-top:42px">이 문서는 공개 연구 노트이며, 학술지 게재 완료 논문을 의미하지 않습니다. 자료와 실험의 한계를 고려해 해석해야 합니다.</div>
   <div class="aside-nav"><a href="/notes.html">← 모든 연구 노트</a><a href="/publications.html">관련 논문 목록 ↗</a></div>
 </article>
</Base>
